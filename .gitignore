.DS_Store
*.refute-bak
evals/results/

# Local Roadworthy state, never content: close.sh writes the evidence ledger and the recorded
# state here, and a gate's output carries absolute paths of the machine that ran it. The scope
# lock belongs to the same class — it is declared when a front starts and removed by close.sh
# when the gates pass, so tracking it forces a housekeeping commit at every close, and leaving
# it untracked keeps the tree dirty and close.sh refuses to run at all. These are the same files
# tree-fingerprint.sh leaves out of the fingerprint, for the same reason.
.roadworthy/evidence.jsonl
.roadworthy/denials.jsonl
.roadworthy/state
.roadworthy/scope
