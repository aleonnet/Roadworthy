#!/usr/bin/env bash
# guard-commit — PreToolUse hook for Bash.
#
# Three guarantees about `git commit`, enforced before the command runs:
#   * forbidden flags (default: --trailer) never reach the history, whatever
#     the wording of the command — the whole command line is inspected,
#     including heredocs, so a false positive costs a rewritten command and
#     a false negative would cost a polluted history;
#   * with `block_empty_commits`, a commit with nothing staged is denied
#     (`git commit -a`, `--all` and `--allow-empty` are left to git);
#   * WHAT ENTERS THE HISTORY IS WHAT THE FRONT DECLARED (0.7.0). The entry gate reads commands,
#     and a program that opens a file itself writes through nothing a reader can name: 25.7% of
#     33,811 real commands use an interpreter or a heredoc (measured 2026-09-30), so "deny what
#     cannot be read" is not available. The commit is where the set is EXACT without guessing --
#     git's own index. A commit is denied when a path it would take is protected; when a front is
#     open and the path is outside its scope; or when no front is open and the path is not one of
#     the rite's own artefacts. However the file was written, it does not enter the history.
#
# The set is what is staged, plus what the same command stages (`git add ... && git commit`),
# plus every tracked change when the commit says `-a`, plus the paths the commit names. It can
# only be LARGER than what git will take, never smaller. What needs no front and no scope: the
# plan (a `.md` directly in the plans directory), `.roadworthy/gates` (the rite writes it and it
# is committed with the front), the owner's own files under .roadworthy/, and whatever the owner
# freed in .roadworthy/free. `commit_scope=false` switches this guarantee off.
#
# Commands that are not a git commit pass untouched. The command is read by hooks/shellread.py,
# the same reader the entry gate uses: until 0.7.0 this hook matched `git commit` with a regular
# expression of its own, and `git -C <dir> commit` was missed by one of its two copies.
#
# Refuted 2026-09-13: injected -- made the forbidden-flag match look for a string that cannot occur;
# tests/run.sh went red with `forbidden flag passed`, green again on the clean file, and the file was
# restored with its SHA-256 verified (skills/refute/scripts/refute.sh).
# Refuted 2026-10-01 (0.7.0): the scope check removed -> tests/hooks/guard-commit.sh red with `a
# file outside the scope reached the history`; the protected check removed -> red with `a file
# outside the scope reached the history (a protected one)`; a merge in progress judged like a
# commit of the front -> tests/meta/rite-liveness.sh red with `the rite has a dead end`. Each green
# again on the clean file, restored with its SHA-256 verified.
# Refuted 2026-10-01, after the cold review of the whole diff (the set is judged by one process
# now, commit_verdict in hooks/frontcheck.py, and the defects are planted there): the scope check
# and the protected check removed -> the same two texts; a cost per path put back -> red with `the
# guard ran out of time on a large commit`; the process dying -> red with `an in-scope commit was
# denied`, which is the guard failing CLOSED; the night's diary and hand-off not recognised -> red
# with `the night could not commit its own diary` and `the hand-off of the night could not be
# committed`.
export RW_HOOK="guard-commit"
export RW_ON_CRASH=deny
source "$(dirname "$0")/lib.sh"
rw_read_event

command="$(rw_field tool_input.command)"
[ -n "$command" ] || exit 0

# The forbidden flags, anywhere in a command that COMMITS -- heredocs included, so a false positive
# costs a rewritten commit and a false negative would cost a polluted history. A command with no
# commit in it is not judged: `grep -rn -- '--trailer' docs/` was refused until 0.7.0.
if printf '%s' "$command" | grep -q -E '(^|[^[:alnum:]_-])commit([^[:alnum:]_]|$)'; then
  forbidden="$(rw_option FORBIDDEN_COMMIT_FLAGS "--trailer")"
  IFS=',' read -r -a flags <<< "$forbidden"
  for flag in "${flags[@]}"; do
    flag="$(printf '%s' "$flag" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    [ -n "$flag" ] || continue
    if printf '%s' "$command" | grep -q -F -- "$flag"; then
      deny PreToolUse "'$flag' is forbidden in commits (forbidden_commit_flags). Rewrite the command without it."
    fi
  done
fi

# The command is read ONCE, by the reader the entry gate uses: which repository each commit runs
# in (after a `cd`, a `git -C`), whether it says `-a`, which paths it names, and what the same
# command stages. Until 0.7.0 the empty check below matched the text with regular expressions of
# its own, and they knew `-a` only as a word by itself: `git commit -am msg` with nothing staged
# was refused as empty, and so was `git commit -m msg -- path` (found by tests/sim/rite-sim.py on
# 2026-10-01, in a scenario that was only trying to commit a fix).
cwd="$(rw_realpath "$(rw_field cwd)")"
[ -n "$cwd" ] || exit 0
read_out="$(RW_CMD="$command" python3 "$(dirname "$0")/shellread.py" "$cwd")"
commits="$(printf '%s\n' "$read_out" | grep -E '^C	' || true)"
[ -n "$commits" ] || exit 0
adds="$(printf '%s\n' "$read_out" | grep -E '^A	' || true)"

# A commit with nothing staged is denied -- when what is staged is ALL it would take: no `-a`, no
# path named, nothing staged by the same command (at hook time the index is still empty and the
# check would lie), and neither --allow-empty nor --amend, which are left to git.
if rw_bool "$(rw_option BLOCK_EMPTY_COMMITS true)" && [ -z "$adds" ] \
   && ! printf '%s' "$command" | grep -q -E -- '(^|[[:space:]])(--allow-empty|--amend)([[:space:]]|$)' \
   && ! printf '%s' "$command" | grep -q -E '(^|[;&|[:space:]])git([[:space:]]+-C[[:space:]]+[^[:space:]]+)?[[:space:]]+(rm|mv|reset|stash|merge|cherry-pick|revert|apply|am|checkout|restore|rebase|submodule|read-tree|update-index)([[:space:]]|$)'; then
  while IFS= read -r dir; do
    [ -n "$dir" ] || continue
    # Only a commit that says nothing beyond "what is staged".
    if printf '%s\n' "$commits" | awk -F'\t' -v d="$dir" '$2 == d && $3 != "-" { found = 1 } END { exit !found }'; then continue; fi
    if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
       && git -C "$dir" diff --cached --quiet 2>/dev/null; then
      deny PreToolUse "nothing is staged in $dir; a commit here would be empty. Stage the intended files first (block_empty_commits)."
    fi
  done <<< "$(printf '%s\n' "$commits" | cut -f2 | sort -u)"
fi

# ── what the commit would take, against what the front declared ──────────────────────────────
rw_bool "$(rw_option COMMIT_SCOPE true)" || exit 0

# taken <root> <directory of the commit> — every path this command would put in the commit.
# (A function, not inline: bash 3.2, which macOS ships, cannot parse a `case` inside `$( )`.)
taken() {
  local root="$1" dir="$2" cdir adir what
  git -C "$root" -c core.quotepath=false diff --cached --name-only 2>/dev/null || true
  while IFS=$'\t' read -r _ cdir what; do
    [ -n "$what" ] || continue
    [ "$(rw_realpath "$cdir")" = "$dir" ] || continue
    if [ "$what" = "-" ]; then :
    elif [ "$what" = "-a" ]; then git -C "$root" -c core.quotepath=false diff --name-only 2>/dev/null || true
    elif [ "$what" = "?" ]; then git -C "$root" -c core.quotepath=false status --porcelain -uall 2>/dev/null | cut -c4- || true
    else (cd "$dir" 2>/dev/null && git -c core.quotepath=false status --porcelain -uall -- "$what" 2>/dev/null | cut -c4-) || true
    fi
  done <<< "$commits"
  while IFS=$'\t' read -r _ adir what; do
    [ -n "$what" ] || continue
    [ "$(rw_target_root "$(rw_realpath "$adir")/x")" = "$root" ] || continue
    if [ "$what" = "*" ]; then git -C "$root" -c core.quotepath=false status --porcelain -uall 2>/dev/null | cut -c4- || true
    else (cd "$adir" 2>/dev/null && git -c core.quotepath=false status --porcelain -uall -- "$what" 2>/dev/null | cut -c4-) || true
    fi
  done <<< "$adds"
}

# One repository at a time: each directory a commit of this command runs in.
while IFS= read -r dir; do
  [ -n "$dir" ] || continue
  dir="$(rw_realpath "$dir")"
  if rw_agent_place "$dir"; then continue; fi       # a toy repository in the scratchpad
  root="$(rw_target_root "$dir/x")"
  [ -n "$root" ] || continue
  export RW_DENIAL_ROOT="$root"
  # The paths, relative to the root, one per line. Larger than what git will take, never smaller.
  taking="$(taken "$root" "$dir" | sed 's/^.* -> //; s/^"//; s/"$//' | grep -v '^$' | sort -u || true)"
  [ -n "$taking" ] || continue
  # Concluding a merge, a rebase, a cherry-pick: what is staged came from the OTHER side, and it
  # is not this front's to answer for. What the front itself changed is measured when git is done.
  gitdir="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null || true)"
  if [ -n "$gitdir" ]; then
    for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
      if [ -e "$gitdir/$marker" ]; then continue 2; fi
    done
  fi

  protected="$(rw_protected_globs "$root")"
  frozen="$(rw_frozen_globs "$root")"
  free="$(rw_free_globs "$root")"
  scope=""
  if [ -f "$root/.roadworthy/scope" ]; then scope="$(rw_list_globs "$root/.roadworthy/scope")"; fi
  # The whole set is judged by ONE process (hooks/frontcheck.py, commit_verdict): a python3 per
  # path and per list ran past this hook's time limit on a commit of 2,200 paths, and a hook that
  # runs out of time does not deny. What needs no front is decided there too: the rite's own
  # artefacts (everything under .roadworthy/, the plan, the night's diary and hand-off) and what
  # the owner freed.
  homes=()
  while IFS= read -r home; do [ -z "$home" ] || homes+=("$home"); done <<< "$(rw_plan_homes "$root")"
  said="$(printf '%s\n' "$taking" | python3 "$(dirname "$0")/frontcheck.py" --commit "$root" "$protected" "$frozen" "$free" "$scope" ${homes[@]+"${homes[@]}"})"
  [ -n "$said" ] || continue
  IFS=$'\t' read -r what first rest <<< "$said"
  if [ "$what" = PROTECTED ]; then
    deny PreToolUse "this commit would take '$first', which is a protected path (protected_paths: $protected). However it was changed, it does not enter the history: put it back (git restore --staged --worktree -- '$first') and report the change you needed. (commit_scope)"
  fi
  if [ "$what" = FROZEN ]; then
    deny PreToolUse "this commit would take '$first', which is frozen for the night (overnight mode, freeze: $frozen). Unstage it (git restore --staged -- '$first'); version bumps and release notes wait for the morning. (commit_scope)"
  fi
  n="$first"; outside="$rest"
  if [ -n "$scope" ]; then
    deny PreToolUse "this commit would take $n path(s) outside the approved scope ($root/.roadworthy/scope): $outside. A file outside the scope does not reach the history, however it was written. Unstage it (git restore --staged -- <path>) and commit what the front declared; if the change is needed, it belongs in the plan's scope, which is the owner's to approve. (commit_scope)"
  fi
  deny PreToolUse "no front is open in $root, and this commit would take $n path(s) that are not the rite's own: $outside. Work enters the history through a front: open one from the approved plan (skills/plan/scripts/scope-write.sh <plan.md>). The plan itself, .roadworthy/gates and what the owner listed in .roadworthy/free commit without one. (commit_scope)"
done <<< "$(printf '%s\n' "$commits" | cut -f2 | sort -u)"
exit 0
