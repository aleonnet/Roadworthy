#!/usr/bin/env bash
# stop-gate — Stop hook. "Done" does not pass while a declared gate is not fresh.
#
# The failure it exists for: a turn ends with the word "done" and the gates were never run on the
# tree that is about to be shipped, or were run before the last commit. The plugin already knows
# the answer -- close.sh --check says FRESH, STALE or MISSING for the tree in front of you -- and
# nobody was asking it at the one moment it matters.
#
# Blocks only when ALL of these hold:
#   * the session is in a git repository;
#   * the project declares gates (.roadworthy/gates exists). WITHOUT A GATES FILE IT NEVER BLOCKS:
#     close.sh --check fails there by design since 0.5.0, and blocking on that would be a false
#     positive in nearly every project on earth;
#   * the final message of the turn claims the work is finished;
#   * close.sh --check does not report every gate FRESH.
#
# Exit 2 is what blocks a turn, and the reason goes to stderr. That is the opposite of every other
# hook here, which denies with structured JSON and exit 0 -- the Stop event has its own contract.
#
# The latch, and why it is keyed on the TREE. A blocked turn that keeps being blocked is a loop, so
# the block is recorded per session. Recording it per session ALONE would make the gate a single
# shot: block once, then let every later claim through. So the latch stores the content
# fingerprint of the tree, and the same tree is not blocked twice while a changed tree is. A latch
# that cannot be written does not block at all: a full disk must not trap a session.
#
# `stop_hook_active` IS honoured. The hooks guide documents it: "Claude Code overrides a Stop hook
# after it blocks eight times in a row without progress. Your hook script needs to check whether
# it already triggered a continuation. Parse the `stop_hook_active` field from the JSON input and
# exit early if it's true". A comment here once said the field was undocumented; that was read on
# 2026-09-14 in the guide itself and was not the case. The latch below stays: the field says a
# continuation already happened in this turn, the latch says this TREE was already judged.
#
# Where the evidence is read from. Every hook gets CLAUDE_PLUGIN_DATA from Claude Code, a
# directory per plugin shared by every project; a person's shell does not set it. Measured on
# 2026-09-14 at 13:33: this hook reported six gates MISSING that `close.sh --check` in the shell
# called FRESH one minute later, because close.sh resolved its ledger through that variable and
# looked in the shared directory. rw_data_dir (hooks/lib.sh) is the one rule now, and it is passed
# to close.sh explicitly so the two cannot disagree again.
#
# A CLAIM, NOT A WORD (0.7.0). The gate matched a vocabulary anywhere in the last 2,000 characters.
# Measured on the 50 transcripts of this machine since 2026-09-14: 4,374 turn ends, 700 matched,
# 177 real blocks -- and 86 of those had the shape of a false positive: the word only in a table
# row, negated, or in "ready to"/"pronto para" (62), or a tail that listed what was still open
# (24). A status report was being blocked as a finished claim, by the very gate whose message asks
# the agent to "say plainly what is left". So a word does not count: in a table row; in a legend
# (a line with three or more status marks); negated within the three words before it; or followed
# by "to/para/when/if". And a tail that declares an open item (`stop_gate_open_markers`, default
# ⬜,🟡,📍,TODO) is not a claim that the work is finished. Measured with the same corpus: 700 turn
# ends judged become 422, and 91 of the 177 blocks stay. Widening the vocabulary instead (feito,
# fechado, aprovado, ✅ -- the proposal of the field note of 2026-09-18) takes 422 to 976 and was
# refused by that number.
#
# EVERY REPOSITORY THE TURN WROTE IN (0.7.0). The session stands in one repository and may edit
# another; the gates that have to be fresh are those of each repository it touched. The entry gate
# notes them, per session, in the plugin's own data directory (never in a project), and this hook
# reads the list.
#
# Fails open, always and by declaration (RW_ON_CRASH=warn): no transcript, an unreadable or
# lagging one (the official documentation warns the transcript is written asynchronously), no
# repository, any internal error. A guard that decides whether work may END must never trap a
# session in a wall it cannot argue with.
#
# Refuted 2026-09-13: injected -- made the gate block even with no gates file declared;
# tests/run.sh went red with `blocked a project with no gates declared`, green again on the clean
# file, and the file was restored with its SHA-256 verified (skills/refute/scripts/refute.sh).
# Refuted 2026-09-14, against tests/hooks/stop-gate.sh: the data directory resolved through
# CLAUDE_PLUGIN_DATA again -> red with `fresh gates blocked from the hook environment` (the 13:33
# case); `stop_hook_active` ignored -> red with `stop_hook_active ignored`. Each green again on the
# clean file, restored with its SHA-256 verified.
# Refuted 2026-10-01 (0.7.0), against tests/hooks/stop-gate.sh: a table row read as a claim -> red
# with `a status report was blocked as a finished claim`; the repositories the session wrote in
# ignored -> red with `the gates of the repository touched were not read`. Each green again on the
# clean file, restored with its SHA-256 verified.
export RW_HOOK="stop-gate"
export RW_ON_CRASH=warn
source "$(dirname "$0")/lib.sh"
rw_read_event

rw_bool "$(rw_option STOP_GATE true)" || exit 0
# A continuation this hook already forced is not judged twice (documented field, see above).
case "$(rw_field stop_hook_active)" in True|true) exit 0 ;; esac

# What counts as claiming the work is finished: a NAMED vocabulary, read as a claim (see above).
# The Portuguese words agree in gender and number: "metade do conserto está pronta" is a finished
# claim about half a fix, and the masculine singular alone let it through (field, 2026-09-14,
# another project: a fix left half done and declared "pronta").
claims_done() {
  RW_FINAL="$1" RW_MARKERS="$(rw_option STOP_GATE_OPEN_MARKERS "⬜,🟡,📍,TODO,still have to,still need to,ainda falta,falta fazer,in progress,em andamento")" python3 - <<'PY'
import os, re, sys
tail = os.environ.get("RW_FINAL", "")[-2000:]
markers = [m.strip() for m in os.environ.get("RW_MARKERS", "").split(",") if m.strip()]
WORD = re.compile(r"(?<![a-zç])(done|finished|completed?|shipped|delivered|all set|ready to (?:ship|merge)|"
                  r"pront[oa]s?|conclu[ií]d[oa]s?|finalizad[oa]s?|entregues?)(?![a-zç])|STATUS: passed", re.I)
NEGATION = {"não", "nao", "not", "no", "never", "nunca", "nem", "ainda", "sem", "without", "isn't", "aren't",
            "wasn't", "weren't", "hasn't", "haven't", "nothing", "nada", "nenhum", "nenhuma"}
PURPOSE = {"para", "pra", "to", "quando", "se", "if", "when", "once", "after", "until", "for", "antes", "before"}
STATUS_MARKS = ("✅", "🟡", "⬜", "📍")
def legend(line):
    return sum(line.count(m) for m in STATUS_MARKS) >= 3
lines = [l for l in tail.splitlines() if not legend(l)]
# A tail that names an open item is a status report, which is exactly what the gate asks for.
if any(m in l for l in lines for m in markers):
    sys.exit(1)
for line in lines:
    if line.lstrip().startswith("|"):
        continue                                # a table row reports the state of an item
    for m in WORD.finditer(line):
        if m.group(0).lower().startswith("ready to") or m.group(0) == "STATUS: passed":
            sys.exit(0)
        before = re.findall(r"[\wçãõáéíóúâêô']+", line[:m.start()].lower())[-3:]
        after = re.findall(r"[\wçãõáéíóúâêô']+", line[m.end():].lower())[:1]
        if any(w in NEGATION or w.endswith("n't") for w in before):
            continue
        if after and after[0] in PURPOSE:
            continue
        sys.exit(0)
sys.exit(1)
PY
}

cwd="$(rw_realpath "$(rw_field cwd)")"
[ -n "$cwd" ] || exit 0
session="$(rw_field session_id)"
[ -n "$session" ] || session="nosession"
session_key="$(printf '%s' "$session" | tr -c 'A-Za-z0-9_.-' '_')"

# The repositories to answer for: the one the session stands in, and every other one the entry
# gate saw this session write in.
roots=""
if git -C "$cwd" rev-parse --is-inside-work-tree >/dev/null 2>&1; then roots="$(rw_root "$cwd")"; fi
touched="$(rw_touched_file "$session_key")"
if [ -n "$touched" ] && [ -f "$touched" ]; then
  roots="$(printf '%s\n%s\n' "$roots" "$(cat "$touched" 2>/dev/null || true)" | grep -v '^$' | sort -u || true)"
fi
[ -n "$roots" ] || exit 0
# WITHOUT A GATES FILE A REPOSITORY NEVER BLOCKS.
with_gates=""
while IFS= read -r r; do
  [ -n "$r" ] && [ -f "$r/.roadworthy/gates" ] || continue
  with_gates="${with_gates}${r}"$'\n'
done <<< "$roots"
[ -n "$with_gates" ] || exit 0

final="$(rw_field last_assistant_message)"
if [ -z "$final" ]; then
  transcript="$(rw_field transcript_path)"
  [ -n "$transcript" ] && [ -f "$transcript" ] || exit 0
  final="$(RW_T="$transcript" python3 - <<'PY'
import json, os
last = ""
try:
    with open(os.environ["RW_T"], encoding="utf-8", errors="replace") as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except Exception:
                continue
            msg = rec.get("message") or {}
            if rec.get("type") == "assistant" or msg.get("role") == "assistant":
                content = msg.get("content")
                if isinstance(content, list):
                    parts = [c.get("text", "") for c in content if isinstance(c, dict) and c.get("type") == "text"]
                    if any(parts):
                        last = "\n".join(parts)
                elif isinstance(content, str) and content:
                    last = content
except Exception:
    last = ""
print(last)
PY
)"
fi
[ -n "$final" ] || exit 0
if ! claims_done "$final"; then exit 0; fi

here="$(cd "$(dirname "$0")" && pwd)"
blocked=""
while IFS= read -r root; do
  [ -n "$root" ] || continue
  data="$(rw_data_dir "$root")"
  # A non-zero --check is the NORMAL answer here, not an error, so the ERR trap must not fire on
  # it. The assignment goes INSIDE the `if`, and errtrace is lifted only for the call so the trap
  # does not fire inside the subshell either.
  set +o errtrace
  if check="$(cd "$root" && ROADWORTHY_DATA="$data" bash "$here/../skills/close/scripts/close.sh" --check 2>&1)"; then
    set -o errtrace
    continue
  fi
  set -o errtrace
  # Not fresh. Record the tree we are blocking on, so the next turn on the SAME tree is not
  # blocked again and the session cannot loop. A latch we cannot write means we do not block.
  latch_dir="$data/stop-latch"
  latch="$latch_dir/$session_key"
  read -r _ wtree _ <<< "$(cd "$root" && bash "$here/../skills/close/scripts/tree-fingerprint.sh" "$root" 2>/dev/null || echo "x x x")"
  if [ -f "$latch" ] && [ "$(cat "$latch" 2>/dev/null)" = "$wtree" ]; then continue; fi
  mkdir -p "$latch_dir" 2>/dev/null || continue
  printf '%s\n' "$wtree" > "$latch" 2>/dev/null || continue
  blocked="${blocked}  in ${root}:"$'\n'"${check}"$'\n\n'
done <<< "$with_gates"
[ -n "$blocked" ] || exit 0

{
  echo "Roadworthy/stop-gate: the turn says the work is finished, and the declared gates are not."
  echo
  printf '%s' "$blocked"
  echo "FRESH means the gate ran on THIS tree and passed. Run the gates after the last commit"
  echo "(/roadworthy:close), or say plainly what is left instead of calling it done."
  echo "This tree is now latched: the same claim on the same tree will not be blocked again."
} >&2
exit 2
