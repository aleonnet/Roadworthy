#!/usr/bin/env bash
# protect-paths — PreToolUse hook for Edit|Write|MultiEdit|NotebookEdit.
#
# Denies any edit whose target path matches one of the `protected_paths`
# globs. This is the mechanical form of "this area is off limits": the model
# cannot talk itself past it. Empty option → the guard is inactive.
#
# WHOSE list (0.7.0). The project's own list (.roadworthy/protected) and the night's freezes are
# read from the repository THE FILE is in, never from the one the session stands in: resolved from
# the session's directory, the protected areas of a repository simply did not exist for a session
# standing in another (field note, 2026-09-18). The same list reaches the shell through rite-gate
# and the index through guard-commit; hooks/lib.sh assembles it in one place.
#
# Refuted 2026-09-13: injected -- read the project list at `$cwd` instead of the repository root;
# tests/run.sh went red with `project protected list inert from a subdirectory`, green again on the clean file, and the file was
# restored with its SHA-256 verified (skills/refute/scripts/refute.sh).
# Refuted 2026-10-01 (0.7.0): the repository of the file not asked -> tests/hooks/protect-paths.sh
# red with `the session repository decided for a file of another`, green again on the clean file,
# restored with its SHA-256 verified.
export RW_HOOK="protect-paths"
export RW_ON_CRASH=deny
source "$(dirname "$0")/lib.sh"
rw_read_event

cwd="$(rw_realpath "$(rw_field cwd)")"
target="$(rw_field tool_input.file_path)"
[ -n "$target" ] || target="$(rw_field tool_input.notebook_path)"
[ -n "$target" ] || exit 0
target="$(rw_realpath "$target")"

# The repository of the file; a file in none is measured from the session's directory, which is
# what the user's own option globs were always written against.
root="$(rw_target_root "$target")"
[ -n "$root" ] || root="$(rw_root "$cwd")"
export RW_DENIAL_ROOT="$root"
globs="$(rw_protected_globs "$root")"
# Overnight mode: while `.roadworthy/overnight` exists, the `freeze:` globs of
# `.roadworthy/overnight-rules` (version files, release notes) join the list —
# a bump or a changelog entry waits for the morning.
frozen="$(rw_frozen_globs "$root")"
[ -n "$globs" ] || [ -n "$frozen" ] || exit 0

relative="$target"
case "$target" in
  "$root"/*) relative="${target#"$root"/}" ;;
esac

if [ -n "$globs" ] && rw_glob_match "$relative" "$globs"; then
  deny PreToolUse "'$relative' is a protected path (protected_paths: $globs). Report the needed change instead of editing it."
fi
if [ -n "$frozen" ]; then
  # Same path as above: both lists are written against the repository root, so there is one
  # relative form, not two.
  if rw_glob_match "$relative" "$frozen"; then
    deny PreToolUse "'$relative' is frozen for the night (overnight mode, freeze: $frozen). Version bumps and release notes wait for the morning; note it in the diary."
  fi
fi
exit 0
