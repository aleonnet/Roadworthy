#!/usr/bin/env bash
# protect-paths — PreToolUse hook for Edit|Write|MultiEdit|NotebookEdit.
#
# Denies any edit whose target path matches one of the `protected_paths`
# globs. This is the mechanical form of "this area is off limits": the model
# cannot talk itself past it. Empty option → the guard is inactive.
export RW_HOOK="protect-paths"
export RW_ON_CRASH=deny
source "$(dirname "$0")/lib.sh"
rw_read_event

cwd="$(rw_realpath "$(rw_field cwd)")"
globs="$(rw_option PROTECTED_PATHS "")"
# The project may declare its own protected globs in .roadworthy/protected
# (one per line, `#` comments); they are joined with the user option.
root="$(rw_root "$cwd")"
# The project's protected list lives at the top level, like every other .roadworthy file.
# Read at "$cwd" it vanished the moment the session stood in a subdirectory.
if [ -n "$root" ] && [ -f "$root/.roadworthy/protected" ]; then
  project="$(grep -v -E '^[[:space:]]*(#|$)' "$root/.roadworthy/protected" | tr '\n' ',' | sed 's/,$//')"
  if [ -n "$project" ]; then globs="${globs:+$globs,}$project"; fi
fi
# Overnight mode: while `.roadworthy/overnight` exists, the `freeze:` globs of
# `.roadworthy/overnight-rules` (version files, release notes) join the list —
# a bump or a changelog entry waits for the morning.
frozen=""
if [ -n "$root" ]; then
  if [ -f "$root/.roadworthy/overnight" ] && [ -f "$root/.roadworthy/overnight-rules" ]; then
    frozen="$(grep -E '^[[:space:]]*freeze:' "$root/.roadworthy/overnight-rules" | sed 's/^[[:space:]]*freeze:[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' | tr '\n' ',' | sed 's/,$//')"
  fi
fi
[ -n "$globs" ] || [ -n "$frozen" ] || exit 0

target="$(rw_field tool_input.file_path)"
[ -n "$target" ] || target="$(rw_field tool_input.notebook_path)"
[ -n "$target" ] || exit 0
target="$(rw_realpath "$target")"

relative="$target"
case "$target" in
  "$root"/*) relative="${target#"$root"/}" ;;
esac

if [ -n "$globs" ] && rw_glob_match "$relative" "$globs"; then
  deny PreToolUse "'$relative' is a protected path (protected_paths: $globs). Report the needed change instead of editing it."
fi
if [ -n "$frozen" ]; then
  # Same path as above: both lists are written against the repository root, so there is one
  # relative form, not two.
  if rw_glob_match "$relative" "$frozen"; then
    deny PreToolUse "'$relative' is frozen for the night (overnight mode, freeze: $frozen). Version bumps and release notes wait for the morning; note it in the diary."
  fi
fi
exit 0
