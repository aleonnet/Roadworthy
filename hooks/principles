#!/usr/bin/env bash
# principles — UserPromptSubmit hook.
#
# Injects two layers of numbered rules at every prompt, so they never lose
# salience in a long session:
#   1. the principles file (bundled, or the user's own via `principles_file`);
#   2. the numbered lines of the current project's auto-memory MEMORY.md,
#      located through the event's transcript_path (`project_rules`).
# A "numbered line" matches ^[0-9]+[a-z]*\. — anything else in those files is
# left alone, so the same file can hold prose and rules.
#
# Never exits 2 (that would erase the prompt). Missing principles file or bad
# stdin → exit 1 with a notice.
#
# Refuted 2026-09-13: injected -- narrowed the numbered-line pattern to `^[9]+[a-z]*`;
# tests/run.sh went red with `bundled principles: 0`, green again on the clean file, and the file was
# restored with its SHA-256 verified (skills/refute/scripts/refute.sh).
# Refuted 2026-09-14, against tests/hooks/principles.sh, on the ledger this hook reads: a second
# resolver planted in the writer (hooks/lib.sh) -> red with `the writer and the reader disagree on
# the ledger`; the one resolver moved to CLAUDE_PLUGIN_DATA -> red with `the denial went to the
# shared plugin directory`. Each green again on the clean file, restored with its SHA-256 verified.
# Refuted 2026-10-01 (0.7.0), against tests/hooks/principles.sh: the session and subagent filter
# removed -> red with `a subagent denial was charged to the front`; the reporting form not injected
# -> red with `the agreed reporting form did not reach the prompt`; the owner's line in the prompt
# not read -> red with `the owner's answer in the prompt was not recorded`. Each green again on the
# clean file, restored with its SHA-256 verified.
export RW_HOOK="principles"
export RW_ON_CRASH=allow
source "$(dirname "$0")/lib.sh"
rw_read_event

principles="$(rw_option PRINCIPLES_FILE "")"
[ -n "$principles" ] || principles="$(cd "$(dirname "$0")/.." && pwd)/principles/PRINCIPLES.md"
[ -f "$principles" ] || { echo "roadworthy/principles: $principles not found; nothing injected" >&2; exit 1; }

project_rules="$(rw_option PROJECT_RULES true)"
transcript="$(rw_field transcript_path)"
cwd="$(rw_realpath "$(rw_field cwd)")"
root="$(rw_root "$cwd")"
# Where the plugin keeps what is not content. The principles file lives OUTSIDE any repository
# and is shared by every project, so its digest cannot live in one of them; it is keyed on the
# absolute path of the file it pins. This is the ONE place CLAUDE_PLUGIN_DATA (per plugin, shared
# by every project, set by Claude Code for every hook) is the right home: the pin is global by
# construction. Evidence of a PROJECT never goes there -- see rw_data_dir in hooks/lib.sh.
data="${ROADWORTHY_DATA:-${CLAUDE_PLUGIN_DATA:-$HOME/.roadworthy}}"
# The denials ledger is project evidence, and it is READ here through the same resolver that
# WRITES it (rw_record_denial in lib.sh). Until 0.6.1 the writer resolved through
# CLAUDE_PLUGIN_DATA and this reader did not, so in a real session the two never met: measured
# on 2026-09-14, six denials in the shared directory, none in the project, and the line below
# had never reached a prompt.
project_data=""
[ -n "$root" ] && project_data="$(rw_data_dir "$root")"

# A PERSON'S ANSWER, READ FROM THE PERSON'S OWN PROMPT (0.7.0). A human verification is the one
# act of the rite an agent cannot perform, and until now the only way to record its answer was a
# command -- which the agent could type as easily as the owner. The entry gate now denies that
# command to the agent; the owner answers by writing a line in the chat:
#     rw-human: all approved
#     rw-human: <item or id> rejected <note>
# This hook fires on the prompt the person submitted, so the line cannot have been written by the
# agent. Whatever fails here is said and never blocks the prompt.
human_notice=""
prompt="$(rw_field prompt)"
if [ -n "$root" ] && printf '%s\n' "$prompt" | grep -q -i -E '^[[:space:]]*rw-human:'; then
  closer="$(cd "$(dirname "$0")/.." && pwd)/skills/close/scripts/close.sh"
  while IFS= read -r line; do
    spec="$(printf '%s' "$line" | sed -E 's/^[[:space:]]*[Rr][Ww]-[Hh][Uu][Mm][Aa][Nn]:[[:space:]]*//')"
    verdict="$(printf '%s' "$spec" | grep -o -i -E '(^|[[:space:]])(approved|rejected|aprovado|aprovada|reprovado|reprovada)([[:space:]]|$)' | head -1 | tr -d '[:space:]' | tr '[:upper:]' '[:lower:]' || true)"
    [ -n "$verdict" ] || { human_notice="${human_notice}A 'rw-human:' line carried no verdict (approved | rejected): $line"$'\n'; continue; }
    item="$(printf '%s' "$spec" | sed -E "s/[[:space:]]*${verdict}.*//I" | sed 's/[[:space:]]*$//')"
    note="$(printf '%s' "$spec" | sed -E "s/^.*${verdict}[[:space:]]*//I")"
    case "$verdict" in aprovad*) verdict=approved ;; reprovad*) verdict=rejected ;; esac
    [ -n "$item" ] || item=all
    case "$item" in tudo|todas|todos) item=all ;; esac
    # A refusal from the closing script is an ANSWER here (no such item), not an internal error:
    # errtrace is lifted for the call so the ERR trap does not fire inside the substitution.
    set +o errtrace
    if answer="$(cd "$root" && ROADWORTHY_DATA="${ROADWORTHY_DATA:-}" bash "$closer" --human "$item" "$verdict" --by "the owner, in the prompt" --note "$note" 2>&1)"; then
      set -o errtrace
      human_notice="${human_notice}THE OWNER ANSWERED A HUMAN VERIFICATION IN THIS PROMPT, and it is recorded: $answer"$'\n'
    else
      set -o errtrace
      human_notice="${human_notice}The owner's 'rw-human:' line could not be recorded: $answer"$'\n'
    fi
  done <<< "$(printf '%s\n' "$prompt" | grep -i -E '^[[:space:]]*rw-human:')"
fi

RW_HUMAN_NOTICE="$human_notice" RW_SESSION="$(rw_field session_id)" \
python3 - "$principles" "$project_rules" "$transcript" "$data" "$root" "$project_data" <<'PY'
import hashlib, json, os, re, sys, time
principles, project_rules, transcript = sys.argv[1], sys.argv[2], sys.argv[3]
data = sys.argv[4] if len(sys.argv) > 4 else ""
root = sys.argv[5] if len(sys.argv) > 5 else ""
project_data = sys.argv[6] if len(sys.argv) > 6 else ""
numbered = re.compile(r"^[0-9]+[a-z]*\. ")

def rules(path):
    with open(path, encoding="utf-8") as fh:
        return [line.rstrip("\n") for line in fh if numbered.match(line)]

general = rules(principles)
if not general:
    sys.stderr.write(f"roadworthy/principles: no numbered lines in {principles}\n"); sys.exit(1)
text = "ROADWORTHY PRINCIPLES — apply before answering, do not merely recall:\n" + "\n".join(general)

if project_rules.lower() in ("1", "true", "yes", "on") and transcript:
    memdir = os.path.join(os.path.dirname(transcript), "memory")
    index = os.path.join(memdir, "MEMORY.md")
    if os.path.isfile(index):
        project = rules(index)
        if project:
            absolute = lambda m: f"]({memdir}/{m.group(1)})"
            project = [re.sub(r"\]\((?!/)([^)]+\.md)\)", absolute, l) for l in project]
            text += f"\n\nPROJECT RULES ({memdir}):\n" + "\n".join(project)

# --- the principles file itself, pinned -------------------------------------------------------
# Nothing can STOP the file being edited: it lives outside every repository, out of reach of
# protect-paths and of the entry gate. What a mechanism can do is refuse to let the change pass
# unannounced. The notice repeats at every prompt while the digest disagrees; accepting the new
# text is a human act -- update the pin -- and that is the point.
notices = []
if data:
    try:
        os.makedirs(data, exist_ok=True)
        key = hashlib.sha256(os.path.abspath(principles).encode()).hexdigest()[:16]
        pin_path = os.path.join(data, "principles." + key + ".json")
        now = hashlib.sha256(open(principles, "rb").read()).hexdigest()
        if os.path.exists(pin_path):
            pin = json.load(open(pin_path, encoding="utf-8"))
            if pin.get("sha256") != now:
                notices.append(
                    "THE PRINCIPLES FILE CHANGED SINCE IT WAS LAST AGREED.\n"
                    "  file:   %s\n  agreed: %s (%s)\n  now:    %s\n"
                    "Nothing here can prevent that edit -- the file lives outside every repository. What it\n"
                    "can do is say so out loud, every prompt, until the owner agrees to the new text by\n"
                    "updating the pin at %s." % (principles, pin.get("sha256", "")[:16],
                                                 pin.get("pinned_at", "unknown date"), now[:16], pin_path))
        else:
            json.dump({"sha256": now, "pinned_at": time.strftime("%Y-%m-%d"), "file": os.path.abspath(principles)},
                      open(pin_path, "w", encoding="utf-8"), indent=1)
    except Exception:
        pass

# --- a fence that keeps denying becomes a rule --------------------------------------------------
# An agent does not remember, but it reads. A denial that happened three times in this front is a
# fact about how this session is behaving, and putting it back into the prompt is the only kind of
# consequence that reaches the next turn. It is NOT a numbered line: those are the principles, and
# the suite counts them.
# WHAT IS COUNTED (0.7.0): the denials of THIS session's main agent, with a scope open, since the
# front opened. A subagent's, another session's, the suite's own fixtures and anything from before
# the front are not this agent's three strikes; and with no scope on disk -- the front closed --
# there is nothing to warn about. Nothing is deleted for it to expire.
snapshot = {}
if root:
    try:
        snapshot = json.load(open(os.path.join(root, ".roadworthy", "plan.snapshot"), encoding="utf-8")) or {}
    except Exception:
        snapshot = {}
session = os.environ.get("RW_SESSION", "")
if root and project_data and os.path.exists(os.path.join(root, ".roadworthy", "scope")):
    try:
        ledger = os.path.join(project_data, "denials.jsonl")
        opened = snapshot.get("ts", "")
        counts = {}
        if os.path.exists(ledger):
            for line in open(ledger, encoding="utf-8"):
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                if r.get("session") != session or r.get("agent") or not r.get("scope_open"):
                    continue
                if r.get("ts", "") < opened:
                    continue
                key = (r.get("hook", "?"), r.get("kind", ""))
                counts[key] = counts.get(key, 0) + 1
        per_hook = {}
        for (h, _), n in counts.items():
            if n >= 3:
                per_hook[h] = max(per_hook.get(h, 0), n)
        repeated = sorted((n, h) for h, n in per_hook.items())
        if repeated:
            lines = ["A FENCE HAS DENIED THE SAME WAY MORE THAN TWICE IN THIS FRONT:"]
            for n, h in reversed(repeated):
                lines.append("  %s: %d denials" % (h, n))
            lines.append("Three refusals are not an obstacle to route around; they are the front telling you")
            lines.append("that what you are trying to do is not what was approved. Say so, or reopen the front.")
            notices.append("\n".join(lines))
    except Exception:
        pass

# The reporting form the owner agreed for THIS front, from the plan's `report:` line, which
# scope-write.sh copied into the approval snapshot. An agent does not remember an agreement; it
# reads one. While the scope is on disk the form is said at every prompt; closed, it stops.
if root and snapshot.get("report") and os.path.exists(os.path.join(root, ".roadworthy", "scope")):
    notices.append("REPORTING FORM AGREED WITH THE OWNER FOR THIS FRONT (%s):\n  %s"
                   % (snapshot.get("plan_name", "the plan"), snapshot["report"]))
if os.environ.get("RW_HUMAN_NOTICE", "").strip():
    notices.append(os.environ["RW_HUMAN_NOTICE"].strip())

if notices:
    text += "\n\n" + "\n\n".join(notices)

print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                          "additionalContext": text}}, ensure_ascii=False))
PY
