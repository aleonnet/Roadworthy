#!/usr/bin/env bash
# principles — UserPromptSubmit hook.
#
# Injects two layers of numbered rules at every prompt, so they never lose
# salience in a long session:
#   1. the principles file (bundled, or the user's own via `principles_file`);
#   2. the numbered lines of the current project's auto-memory MEMORY.md,
#      located through the event's transcript_path (`project_rules`).
# A "numbered line" matches ^[0-9]+[a-z]*\. — anything else in those files is
# left alone, so the same file can hold prose and rules.
#
# Never exits 2 (that would erase the prompt). Missing principles file or bad
# stdin → exit 1 with a notice.
export RW_HOOK="principles"
source "$(dirname "$0")/lib.sh"
rw_read_event

principles="$(rw_option PRINCIPLES_FILE "")"
[ -n "$principles" ] || principles="$(cd "$(dirname "$0")/.." && pwd)/principles/PRINCIPLES.md"
[ -f "$principles" ] || { echo "roadworthy/principles: $principles not found; nothing injected" >&2; exit 1; }

project_rules="$(rw_option PROJECT_RULES true)"
transcript="$(rw_field transcript_path)"

python3 - "$principles" "$project_rules" "$transcript" <<'PY'
import json, os, re, sys
principles, project_rules, transcript = sys.argv[1], sys.argv[2], sys.argv[3]
numbered = re.compile(r"^[0-9]+[a-z]*\. ")

def rules(path):
    with open(path, encoding="utf-8") as fh:
        return [line.rstrip("\n") for line in fh if numbered.match(line)]

general = rules(principles)
if not general:
    sys.stderr.write(f"roadworthy/principles: no numbered lines in {principles}\n"); sys.exit(1)
text = "ROADWORTHY PRINCIPLES — apply before answering, do not merely recall:\n" + "\n".join(general)

if project_rules.lower() in ("1", "true", "yes", "on") and transcript:
    memdir = os.path.join(os.path.dirname(transcript), "memory")
    index = os.path.join(memdir, "MEMORY.md")
    if os.path.isfile(index):
        project = rules(index)
        if project:
            absolute = lambda m: f"]({memdir}/{m.group(1)})"
            project = [re.sub(r"\]\((?!/)([^)]+\.md)\)", absolute, l) for l in project]
            text += f"\n\nPROJECT RULES ({memdir}):\n" + "\n".join(project)

print(json.dumps({"hookSpecificOutput": {"hookEventName": "UserPromptSubmit",
                                          "additionalContext": text}}, ensure_ascii=False))
PY
